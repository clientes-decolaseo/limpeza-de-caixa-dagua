---
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import PhoneRegions from '../../components/PhoneRegions.astro';
import PostCard from '../../components/PostCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { toBlogSlug } from '../../utils/blog';

export async function getStaticPaths() {
	const posts = await getCollection('blog');

	return posts.map((entry) => ({
		params: { slug: toBlogSlug(entry.id) },
		props: { entry },
	}));
}

interface Props {
	entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const site = Astro.site ?? new URL('https://limpezadecaixasdagua.eco.br');
const slug = toBlogSlug(entry.id);
const canonical = new URL(`/blog/${slug}/`, site).href;
const pageTitle = `${entry.data.title} | Blog Universo Ambiental`;
const hero = entry.data.heroImage;
const published = entry.data.pubDate;
const modified = entry.data.updatedDate ?? published;

if ([...entry.data.metaDescription].length > 160) {
	throw new Error(`Meta description de ${slug} com ${[...entry.data.metaDescription].length} caracteres.`);
}

const pubLabel = new Intl.DateTimeFormat('pt-BR', {
	day: 'numeric',
	month: 'long',
	year: 'numeric',
	timeZone: 'UTC',
}).format(published);

const updatedLabel =
	entry.data.updatedDate != null
		? new Intl.DateTimeFormat('pt-BR', {
				day: 'numeric',
				month: 'long',
				year: 'numeric',
				timeZone: 'UTC',
			}).format(entry.data.updatedDate)
		: null;

const tagSet = new Set(entry.data.tags);
const relatedPosts = (await getCollection('blog'))
	.filter((post) => toBlogSlug(post.id) !== slug)
	.filter((post) => post.data.tags.some((tag) => tagSet.has(tag)))
	.sort((a, b) => {
		const sharedA = a.data.tags.filter((tag) => tagSet.has(tag)).length;
		const sharedB = b.data.tags.filter((tag) => tagSet.has(tag)).length;
		if (sharedB !== sharedA) return sharedB - sharedA;
		return b.data.pubDate.getTime() - a.data.pubDate.getTime();
	})
	.slice(0, 3);

const ogImage = new URL(`/og-images/${slug}.jpg`, site).href;

const articleSchema = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: entry.data.title,
	description: entry.data.metaDescription,
	url: canonical,
	datePublished: published.toISOString(),
	dateModified: modified.toISOString(),
	image: ogImage,
	author: {
		'@type': 'Organization',
		name: 'Universo Ambiental',
		url: site.href,
	},
	publisher: {
		'@type': 'Organization',
		name: 'Universo Ambiental',
		url: site.href,
	},
	mainEntityOfPage: {
		'@type': 'WebPage',
		'@id': canonical,
	},
};

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{
			'@type': 'ListItem',
			position: 1,
			name: 'Home',
			item: new URL('/', site).href,
		},
		{
			'@type': 'ListItem',
			position: 2,
			name: 'Blog',
			item: new URL('/blog/', site).href,
		},
		{
			'@type': 'ListItem',
			position: 3,
			name: entry.data.title,
			item: canonical,
		},
	],
};
---

<BaseLayout
	title={pageTitle}
	description={entry.data.metaDescription}
	canonical={canonical}
	ogImage={ogImage}
	ogType="article"
>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
	</Fragment>

	<article>
		<nav class="breadcrumb" aria-label="Trilha de navegação">
			<ol>
				<li><a href="/">Home</a></li>
				<li><a href="/blog/">Blog</a></li>
				<li aria-current="page">{entry.data.title}</li>
			</ol>
		</nav>

		<header class="hero">
			<div class="hero-copy">
				<h1>{entry.data.title}</h1>
				<p class="meta">
					<time datetime={published.toISOString().slice(0, 10)}>{pubLabel}</time>
					{
						updatedLabel && (
							<>
								<span aria-hidden="true"> · </span>
								<span>
									Atualizado em <time datetime={modified.toISOString().slice(0, 10)}>{updatedLabel}</time>
								</span>
							</>
						)
					}
				</p>
				{
					entry.data.tags.length > 0 && (
						<ul class="tags" aria-label="Assuntos">
							{entry.data.tags.map((tag) => (
								<li>{tag.replaceAll('-', ' ')}</li>
							))}
						</ul>
					)
				}
			</div>
			<div class="hero-media">
				<Image
					src={hero}
					alt={entry.data.heroImageAlt}
					width={1200}
					height={Math.round((1200 / hero.width) * hero.height)}
					format="webp"
					quality="mid"
					loading="eager"
					fetchpriority="high"
					sizes="(min-width: 64rem) 50vw, 100vw"
				/>
			</div>
		</header>

		<div class="content">
			<Content />
		</div>

		{
			relatedPosts.length > 0 && (
				<section class="related" aria-labelledby="related-heading">
					<h2 id="related-heading">Posts relacionados</h2>
					<ul class="related-grid">
						{relatedPosts.map((post) => (
							<li>
								<PostCard
									image={post.data.heroImage}
									alt={post.data.heroImageAlt}
									title={post.data.title}
									excerpt={post.data.excerpt}
									href={`/blog/${toBlogSlug(post.id)}/`}
									pubDate={post.data.pubDate}
									headingLevel="h3"
								/>
							</li>
						))}
					</ul>
				</section>
			)
		}

		<section class="cta" aria-labelledby="cta-heading">
			<h2 id="cta-heading">Fale com a equipe</h2>
			<p>
				Precisa de higienização ou limpeza? Peça um orçamento gratuito pelo telefone ou pela
				página de <a href="/contato/">contato</a>.
			</p>
			<PhoneRegions variant="compact" />
		</section>
	</article>
</BaseLayout>

<style>
	article {
		padding-bottom: var(--space-16);
	}

	.breadcrumb {
		max-width: 72rem;
		margin: 0 auto;
		padding: var(--space-4);
	}

	.breadcrumb ol {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin: 0;
		padding: 0;
		list-style: none;
		color: var(--color-ink-soft);
		font-size: 0.9rem;
	}

	.breadcrumb li:not(:last-child)::after {
		content: '>';
		margin-left: var(--space-2);
		color: var(--color-border);
	}

	.breadcrumb a {
		color: var(--color-primary-dark);
		text-decoration: none;
	}

	.breadcrumb a:hover {
		text-decoration: underline;
	}

	.breadcrumb [aria-current='page'] {
		color: var(--color-ink);
		font-weight: 600;
	}

	.hero {
		display: grid;
		gap: var(--space-8);
		padding: var(--space-8) var(--space-4) var(--space-12);
		background-color: var(--color-primary-light);
	}

	.hero-copy,
	.hero-media {
		max-width: 72rem;
		width: 100%;
		margin-inline: auto;
	}

	h1,
	h2 {
		margin: 0 0 var(--space-4);
		line-height: 1.2;
		color: var(--color-ink);
	}

	h1 {
		font-size: clamp(1.75rem, 4vw, 2.75rem);
	}

	.meta,
	.cta p {
		margin: 0;
		max-width: 42rem;
		color: var(--color-ink-soft);
		line-height: 1.6;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin: var(--space-4) 0 0;
		padding: 0;
		list-style: none;
	}

	.tags li {
		padding: var(--space-1) var(--space-3);
		border-radius: 999px;
		background-color: var(--color-bg);
		border: 1px solid var(--color-border);
		color: var(--color-ink);
		font-size: 0.8rem;
		font-weight: 600;
		text-transform: capitalize;
	}

	.hero-media :global(img) {
		display: block;
		width: 100%;
		height: auto;
		border-radius: var(--radius-lg);
		object-fit: cover;
	}

	.content,
	.related,
	.cta {
		max-width: 48rem;
		margin: 0 auto;
		padding: var(--space-12) var(--space-4) 0;
	}

	.related,
	.cta {
		max-width: 72rem;
	}

	.content :global(h2) {
		margin: var(--space-8) 0 var(--space-4);
		font-family: var(--font-heading);
		font-size: clamp(1.35rem, 2.5vw, 1.75rem);
		line-height: 1.3;
		color: var(--color-ink);
	}

	.content :global(h2:first-child) {
		margin-top: 0;
	}

	.content :global(p),
	.content :global(li) {
		color: var(--color-ink-soft);
		line-height: 1.7;
	}

	.content :global(p) {
		margin: 0 0 var(--space-4);
	}

	.content :global(ul),
	.content :global(ol) {
		margin: 0 0 var(--space-4);
		padding-left: 1.25rem;
	}

	.content :global(li + li) {
		margin-top: var(--space-2);
	}

	.content :global(a) {
		color: var(--color-primary-dark);
		font-weight: 600;
	}

	.related h2,
	.cta h2 {
		font-size: clamp(1.5rem, 3vw, 2rem);
	}

	.related-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-6);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.cta p {
		margin-bottom: var(--space-6);
	}

	.cta a {
		color: var(--color-primary-dark);
		font-weight: 700;
	}

	@media (min-width: 40rem) {
		.related-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 64rem) {
		.hero {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
			gap: var(--space-12);
			padding: var(--space-12) var(--space-8) var(--space-16);
			align-items: center;
		}

		.hero-copy,
		.hero-media {
			max-width: none;
			margin: 0;
		}

		.hero-copy {
			padding-left: max(0px, calc((100vw - 72rem) / 2));
		}

		.hero-media {
			padding-right: max(0px, calc((100vw - 72rem) / 2));
		}

		.content {
			padding-top: var(--space-16);
		}

		.related,
		.cta {
			padding: var(--space-16) var(--space-8) 0;
		}

		.related-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
</style>
