---
import { getCollection } from 'astro:content';
import ServiceCard from '../../components/ServiceCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const site = Astro.site ?? new URL('https://limpezadecaixasdagua.eco.br');
const canonical = new URL('/servicos/', site).href;
const title = 'Nossos Serviços | Universo Ambiental';
const description =
	"Serviços da Universo Ambiental: caixa d'água, calhas, coifas, fossa, hidrojateamento e caixa de gordura em São Paulo e região. Orçamento grátis.";

if ([...description].length > 160) {
	throw new Error(`Meta description com ${[...description].length} caracteres (máximo 160).`);
}

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{
			'@type': 'ListItem',
			position: 1,
			name: 'Home',
			item: new URL('/', site).href,
		},
		{
			'@type': 'ListItem',
			position: 2,
			name: 'Serviços',
			item: canonical,
		},
	],
};

const itemListSchema = {
	'@context': 'https://schema.org',
	'@type': 'ItemList',
	name: 'Serviços da Universo Ambiental',
	itemListElement: services.map((service, index) => ({
		'@type': 'ListItem',
		position: index + 1,
		name: service.data.title,
		url: new URL(`/servicos/${service.data.slug}`, site).href,
		description: service.data.shortDescription,
	})),
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
	</Fragment>

	<section class="listing" aria-labelledby="servicos-heading">
		<header class="intro">
			<nav class="breadcrumb" aria-label="Trilha de navegação">
				<ol>
					<li><a href="/">Home</a></li>
					<li aria-current="page">Serviços</li>
				</ol>
			</nav>
			<h1 id="servicos-heading">Nossos Serviços</h1>
			<p>
				A Universo Ambiental reúne higienização de reservatórios e serviços de limpeza complementar
				para residências, condomínios e empresas na Grande São Paulo. Abra cada serviço para ver o
				processo, as recomendações de manutenção e como solicitar um orçamento.
			</p>
		</header>

		<ul class="service-grid">
			{
				services.map((service) => (
					<li>
						<ServiceCard
							image={service.data.heroImage}
							alt={service.data.heroImageAlt}
							title={service.data.title}
							description={service.data.shortDescription}
							href={`/servicos/${service.data.slug}`}
							headingLevel="h2"
						/>
					</li>
				))
			}
		</ul>
	</section>
</BaseLayout>

<style>
	.listing {
		max-width: 72rem;
		margin: 0 auto;
		padding: var(--space-8) var(--space-4) var(--space-16);
	}

	.breadcrumb ol {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin: 0 0 var(--space-6);
		padding: 0;
		list-style: none;
		color: var(--color-ink-soft);
		font-size: 0.9rem;
	}

	.breadcrumb li:not(:last-child)::after {
		content: '>';
		margin-left: var(--space-2);
		color: var(--color-border);
	}

	.breadcrumb a {
		color: var(--color-primary-dark);
		text-decoration: none;
	}

	.breadcrumb a:hover {
		text-decoration: underline;
	}

	.breadcrumb [aria-current='page'] {
		color: var(--color-ink);
		font-weight: 600;
	}

	h1 {
		margin: 0 0 var(--space-4);
		font-size: clamp(1.75rem, 4vw, 2.75rem);
		line-height: 1.2;
		color: var(--color-ink);
	}

	.intro p {
		margin: 0 0 var(--space-12);
		max-width: 42rem;
		color: var(--color-ink-soft);
		line-height: 1.6;
	}

	.service-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-6);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	@media (min-width: 40rem) {
		.service-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 64rem) {
		.listing {
			padding: var(--space-12) var(--space-8) var(--space-24);
		}

		.service-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
</style>
