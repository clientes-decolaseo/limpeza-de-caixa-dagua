---
import { getEntry } from 'astro:content';

interface Props {
	items?: {
		name: string;
		description: string;
	}[];
}

const { items } = Astro.props;
const entry = items ? undefined : await getEntry('industrial', 'hidrojateamento-industrial');
const segments = items ?? entry?.data.segments ?? [];
---

{
	segments.length > 0 && (
		<section class="segments" aria-label="Segmentos industriais">
			<ul>
				{segments.map((segment) => (
					<li>
						<article>
							<h3>{segment.name}</h3>
							<p>{segment.description}</p>
						</article>
					</li>
				))}
			</ul>
		</section>
	)
}

<style>
	.segments {
		margin: var(--space-8) 0;
	}

	ul {
		display: grid;
		gap: var(--space-4);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	article {
		height: 100%;
		padding: var(--space-6);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background-color: var(--color-bg);
	}

	h3 {
		margin: 0 0 var(--space-3);
		font-size: 1.05rem;
		color: var(--color-ink);
	}

	p {
		margin: 0;
		color: var(--color-ink-soft);
		line-height: 1.6;
	}

	@media (min-width: 40rem) {
		ul {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>
