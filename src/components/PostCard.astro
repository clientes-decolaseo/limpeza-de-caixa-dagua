---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
	image: ImageMetadata;
	alt: string;
	title: string;
	excerpt: string;
	href: string;
	pubDate: Date;
	headingLevel?: 'h2' | 'h3';
}

const { image, alt, title, excerpt, href, pubDate, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;

const dateLabel = new Intl.DateTimeFormat('pt-BR', {
	day: 'numeric',
	month: 'long',
	year: 'numeric',
	timeZone: 'UTC',
}).format(pubDate);

const dateTime = pubDate.toISOString().slice(0, 10);
---

<article class="card">
	<div class="card-media">
		<Image
			src={image}
			alt={alt}
			width={640}
			height={427}
			format="webp"
			quality="mid"
			loading="lazy"
			sizes="(min-width: 64rem) 30vw, (min-width: 40rem) 45vw, 100vw"
		/>
	</div>
	<div class="card-body">
		<time datetime={dateTime}>{dateLabel}</time>
		<Heading>{title}</Heading>
		<p>{excerpt}</p>
		<a href={href}>Ler artigo</a>
	</div>
</article>

<style>
	.card {
		display: flex;
		flex-direction: column;
		height: 100%;
		overflow: hidden;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background-color: var(--color-bg);
	}

	.card-media {
		position: relative;
		aspect-ratio: 3 / 2;
		overflow: hidden;
		background-color: var(--color-bg-alt);
	}

	.card-media :global(img) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.card-body {
		padding: var(--space-4);
	}

	time {
		display: block;
		margin: 0 0 var(--space-2);
		color: var(--color-ink-soft);
		font-size: 0.85rem;
	}

	.card-body :global(h2),
	.card-body :global(h3) {
		margin: 0 0 var(--space-2);
		font-size: 1.1rem;
	}

	.card-body p {
		margin: 0 0 var(--space-4);
		color: var(--color-ink-soft);
		font-size: 0.95rem;
		line-height: 1.5;
	}

	.card-body a {
		font-weight: 700;
		color: var(--color-primary-dark);
		text-decoration: none;
	}

	.card-body a:hover {
		text-decoration: underline;
	}
</style>
