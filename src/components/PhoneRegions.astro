---
import { getCollection } from 'astro:content';

interface Props {
	variant?: 'full' | 'compact' | 'boxes';
	prominent?: boolean;
}

const { variant = 'full', prominent = false } = Astro.props;

const REGION_ORDER = [
	'sao-paulo',
	'vale-do-paraiba',
	'campinas',
	'jundiai',
	'sorocaba',
	'santos',
] as const;

const regions = (await getCollection('regions')).sort((a, b) => {
	const indexA = REGION_ORDER.indexOf(a.id as (typeof REGION_ORDER)[number]);
	const indexB = REGION_ORDER.indexOf(b.id as (typeof REGION_ORDER)[number]);
	return (indexA === -1 ? REGION_ORDER.length : indexA) - (indexB === -1 ? REGION_ORDER.length : indexB);
});

const principal = regions.find((region) => region.id === 'sao-paulo') ?? regions[0];

function whatsappHref(whatsapp: string) {
	return `https://wa.me/${whatsapp.replace('+', '')}`;
}
---

{
	variant === 'compact' && principal && (
		<p class="phone-compact">
			<a
				href={`tel:${principal.data.phone}`}
				aria-label={`Ligar para ${principal.data.name}: ${principal.data.phoneDisplay}`}
			>
				{principal.data.phoneDisplay}
			</a>
		</p>
	)
}

{
	variant === 'boxes' && (
		<ul class="phone-boxes">
			{regions.map((region) => (
				<li>
					<a
						href={whatsappHref(region.data.whatsapp)}
						rel="noopener"
						target="_blank"
						aria-label={`WhatsApp ${region.data.whatsappDisplay} (${region.data.name}, abre em nova aba)`}
					>
						<span class="box-number">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor">
								<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
							</svg>
							{region.data.whatsappDisplay}
						</span>
						<span class="box-region">{region.data.name}</span>
					</a>
				</li>
			))}
		</ul>
	)
}

{
	variant === 'full' && (
		<ul class:list={['phone-list', prominent && 'prominent']}>
			{regions.map((region) => (
				<li>
					<p class="region-name">{region.data.name}</p>
					<p>
						<a
							href={`tel:${region.data.phone}`}
							aria-label={`Telefone ${region.data.name}: ${region.data.phoneDisplay}`}
						>
							{region.data.phoneDisplay}
						</a>
					</p>
					<p>
						<a
							class="whatsapp"
							href={whatsappHref(region.data.whatsapp)}
							rel="noopener"
							target="_blank"
							aria-label={`WhatsApp ${region.data.whatsappDisplay} (${region.data.name}, abre em nova aba)`}
						>
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor">
								<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
							</svg>
							WhatsApp {region.data.whatsappDisplay}
						</a>
					</p>
				</li>
			))}
		</ul>
	)
}

<style>
	.phone-boxes {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-3);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.phone-boxes a {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		height: 100%;
		padding: 0.875rem 1rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		background-color: var(--color-bg);
		box-shadow: 0 1px 3px rgb(20 35 43 / 0.06);
		text-decoration: none;
		transition: border-color 0.15s ease, box-shadow 0.15s ease;
	}

	.phone-boxes a:hover {
		border-color: var(--color-primary);
		box-shadow: 0 2px 8px rgb(20 35 43 / 0.1);
	}

	.box-number {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		color: var(--color-ink);
		font-weight: 700;
		font-size: 0.95rem;
		line-height: 1.3;
		letter-spacing: -0.01em;
		white-space: nowrap;
	}

	.box-number svg {
		flex-shrink: 0;
		color: var(--color-primary-dark);
	}

	.box-region {
		color: var(--color-primary);
		font-size: 0.8rem;
		line-height: 1.35;
	}

	.phone-compact {
		margin: 0;
	}

	.phone-compact a {
		display: inline-flex;
		align-items: center;
		color: var(--color-primary-dark);
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
	}

	.phone-compact a:hover {
		color: var(--color-primary);
		text-decoration: underline;
	}

	.phone-list {
		display: grid;
		gap: var(--space-6);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.phone-list p {
		margin: 0;
	}

	.region-name {
		margin-bottom: var(--space-2);
		color: var(--color-ink);
		font-family: var(--font-heading);
		font-size: 0.95rem;
		font-weight: 700;
	}

	.phone-list a {
		color: var(--color-ink-soft);
		text-decoration: none;
	}

	.phone-list a:hover {
		color: var(--color-primary);
		text-decoration: underline;
	}

	.whatsapp {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		margin-top: var(--space-2);
		font-weight: 600;
	}

	.whatsapp svg {
		flex-shrink: 0;
	}

	.prominent li {
		padding: var(--space-6);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background-color: var(--color-bg);
	}

	.prominent .region-name {
		margin-bottom: var(--space-3);
		font-size: 1.15rem;
	}

	.prominent a:not(.whatsapp) {
		font-size: 1.05rem;
		font-weight: 600;
		color: var(--color-primary-dark);
	}

	.prominent .whatsapp {
		display: inline-flex;
		margin-top: var(--space-4);
		min-height: 2.75rem;
		padding: var(--space-3) var(--space-4);
		border-radius: var(--radius);
		background-color: var(--color-cta);
		color: var(--color-bg);
		font-weight: 700;
		box-shadow: inset 0 0 0 1px var(--color-cta-light);
	}

	.prominent .whatsapp:hover {
		background-color: var(--color-cta-dark);
		color: var(--color-bg);
		text-decoration: none;
	}

	@media (min-width: 40rem) {
		.phone-list,
		.phone-boxes {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 64rem) {
		.phone-list,
		.phone-boxes {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (min-width: 75rem) {
		.phone-boxes {
			grid-template-columns: repeat(6, minmax(0, 1fr));
		}

		.phone-boxes a {
			padding: 0.875rem 0.75rem;
		}

		.box-number {
			font-size: 0.85rem;
		}
	}
</style>
